{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-local-government-assistant",
  "main": "src/search-worker.js",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "secrets": {
    "required": ["TAVILY_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "OFFICIAL_SEARCH_RATE_LIMITER",
      "namespace_id": "7001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  }
}
