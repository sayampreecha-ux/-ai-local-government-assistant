{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-local-government-assistant",
  "main": "src/search-worker-v2.js",
  "compatibility_date": "2026-08-10",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "secrets": {
    "required": [
      "TAVILY_API_KEY",
      "ACCESS_CODE_SECRET",
      "ACCESS_ADMIN_PASSWORD_HASH",
      "ACCESS_ADMIN_SESSION_SECRET"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 0.05,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  }
}