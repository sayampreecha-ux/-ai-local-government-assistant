{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-local-government-assistant",
  "main": "src/search-worker-v2.js",
  "compatibility_date": "2026-08-10",
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 0.05,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  }
}
